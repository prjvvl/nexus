---
/** A static recreation of the real dashboard (ui/src/App.tsx) - same
 * layout and the real demo entries from manifest.example.yaml, not an
 * invented example. Not a screenshot: no dashboard is running when this
 * site builds, so this is redrawn by hand with the site's own tokens
 * rather than the dashboard's own Tailwind config, which this site
 * doesn't share. */
---

<div class="rounded-card border border-border bg-surface p-5 md:p-6">
  <p class="text-xs font-semibold tracking-wider text-fg-muted uppercase">Services</p>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3 rounded-md border border-border bg-bg/50 p-4">
    <div class="flex items-center gap-3">
      <span class="font-medium text-fg">nexus-demo</span>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-success-bg px-2.5 py-0.5 text-xs font-medium text-success">
        <span class="size-1.5 rounded-full bg-success"></span>
        running
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-3 text-xs text-fg-muted">
      <span class="inline-flex items-center gap-1.5">
        <span class="relative inline-flex h-4 w-7 items-center rounded-full bg-brand/80">
          <span class="absolute right-0.5 size-3 rounded-full bg-white"></span>
        </span>
        autostart
      </span>
      <span>last run 3m ago</span>
      <span class="rounded-md border border-border px-2.5 py-1">Logs</span>
      <span class="rounded-md border border-border px-2.5 py-1">Restart</span>
      <span class="rounded-md bg-error-bg px-2.5 py-1 text-error">Stop</span>
    </div>
  </div>

  <p class="mt-5 text-xs font-semibold tracking-wider text-fg-muted uppercase">Scheduled jobs</p>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3 rounded-md border border-border bg-bg/50 p-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="font-medium text-fg">nexus-demo-job</span>
        <code class="rounded bg-surface-hover px-2 py-0.5 text-xs text-fg-muted">*/2 * * * *</code>
      </div>
      <p class="mt-1 text-xs text-fg-muted">last run 1m ago · next run in 1m</p>
    </div>
    <span class="rounded-md border border-border px-2.5 py-1 text-xs text-fg-muted">Run now</span>
  </div>
</div>
